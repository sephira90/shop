APP_NAME=Laravel
APP_ENV=stage
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shop_stage
DB_USERNAME=shop
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_TOKEN_EXPIRATION_MINUTES=1440

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SHOP_ADMIN_EMAIL=admin@shop.local
SHOP_ADMIN_PASSWORD=

PAYMENT_DRIVER=fake-payment
SHIPPING_DRIVER=fake-shipping

APP_OBSERVABILITY_ALERTS_ENABLED=true
APP_OBSERVABILITY_ALERTS_CRON="*/30 * * * *"
APP_OBSERVABILITY_ALERTS_WINDOW_MINUTES=120
APP_OBSERVABILITY_ALERTS_MAX_API_SLOW_RATE=0.30
APP_OBSERVABILITY_ALERTS_MAX_WEBHOOK_LAG_WARN_RATE=0.30
APP_OBSERVABILITY_ALERTS_REQUIRE_API_SAMPLES=true
APP_OBSERVABILITY_ALERTS_REQUIRE_WEBHOOK_SAMPLES=true
APP_OBSERVABILITY_ALERTS_COOLDOWN_MINUTES=30
APP_OBSERVABILITY_ALERTS_EMAIL_ENABLED=false
APP_OBSERVABILITY_ALERTS_EMAIL_RECIPIENTS=
APP_OBSERVABILITY_ALERTS_SLACK_ENABLED=false
APP_OBSERVABILITY_ALERTS_SLACK_WEBHOOK_URL=
APP_OBSERVABILITY_ALERTS_PAGERDUTY_ENABLED=false
APP_OBSERVABILITY_ALERTS_PAGERDUTY_INTEGRATION_KEY=
APP_OBSERVABILITY_ALERTS_PAGERDUTY_SEVERITY=warning
APP_ONCALL_DRILL_ENABLED=true
APP_ONCALL_DRILL_CRON="45 3 * * *"
APP_ONCALL_DRILL_WITH_WRITE_SMOKES=false
APP_ONCALL_DRILL_PERSIST=false

APP_CLEANUP_ENABLED=true
APP_CLEANUP_CRON="17 * * * *"
APP_CLEANUP_IDEMPOTENCY_RETAIN_HOURS=168
APP_CLEANUP_WEBHOOK_RETAIN_HOURS=720
APP_CLEANUP_ACTIVE_CART_RETAIN_HOURS=720
APP_CLEANUP_INACTIVE_CART_RETAIN_HOURS=168
