<?xml version="1.0"?>
<psalm
    errorLevel="4"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedBaselineEntry="true"
    findUnusedCode="false"
>
    <projectFiles>
        <directory name="app" />
        <directory name="routes" />
        <directory name="database/factories" />
        <directory name="database/seeders" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>
    <plugins>
        <pluginClass class="Psalm\LaravelPlugin\Plugin" />
    </plugins>
    <!--
        LengthAwarePaginator template-arity divergence.

        larastan (PHPStan) types Illuminate\Pagination\LengthAwarePaginator as a
        2-parameter template `<TKey, TValue>` (Collection-like), which matches
        the PHPDoc conventions used across this codebase. psalm/plugin-laravel
        on the PHP 8.4.1 / Psalm 6.4.1 line pins the class to Laravel's upstream
        1-parameter form `<TValue>`, so every project-side
        `LengthAwarePaginator<int, Model>` annotation surfaces TooManyTemplateParams.

        The 2-parameter form is correct for larastan and matches the project's
        existing PHPStan level 10 baseline; switching to the 1-parameter form
        would break PHPStan parity. The divergence is closed upstream in
        psalm/plugin-laravel v3.14 (PR #1082), which requires PHP ~8.4.3 and
        Psalm ^6.16.1 — both blocked by the current OSPanel-managed PHP 8.4.1
        runtime. Until the runtime is upgraded, TooManyTemplateParams is
        suppressed for the directories and files where the paginator annotation
        appears, as a documented plugin-version tradeoff rather than a baseline
        accumulation. The suppress scope is enumerable and removable in a single
        edit once the plugin is upgraded.
    -->
    <issueHandlers>
        <TooManyTemplateParams>
            <errorLevel type="suppress">
                <directory name="app/Application" />
                <directory name="app/Repositories" />
                <directory name="app/Domains/Catalog/Repositories" />
                <directory name="app/Domains/Catalog/Application/Dto" />
                <directory name="app/Domains/Users/Repositories" />
                <directory name="app/Domains/Users/Application/Dto" />
                <directory name="app/Domains/Cart/Services" />
                <directory name="app/Domains/Cart/Application/Dto" />
                <directory name="app/Domains/Checkout/Services" />
                <directory name="app/Domains/Checkout/Application/Dto" />
                <file name="app/Domains/Catalog/Contracts/CatalogProductReadRepository.php" />
                <file name="app/Domains/Catalog/Contracts/CatalogReadService.php" />
                <file name="app/Domains/Catalog/Services/CatalogService.php" />
                <file name="app/Domains/Users/Contracts/AccountOrderReadRepository.php" />
                <file name="app/Support/Api/ApiResponse.php" />
            </errorLevel>
        </TooManyTemplateParams>
        <!--
            Eloquent relation template-arity divergence (companion to the
            LengthAwarePaginator note above). larastan types BelongsTo, HasMany,
            HasOne and BelongsToMany as 2-parameter templates
            `<TRelatedModel, TDeclaringModel>`, which matches the project-side
            `@return BelongsTo<User, $this>` convention and the repository-side
            `\Closure(Relation<*, *, *>): mixed` shapes accepted by Builder::with().
            psalm/plugin-laravel on the PHP 8.4.1 / Psalm 6.4.1 line types these
            relations as 1-parameter `<TRelatedModel>`, surfacing InvalidDocblock
            "Unexpected space in docblock" / "Invalid type 'App\Repositories\*'"
            for every project-side 2-parameter relation annotation. Switching to
            the 1-parameter form would break PHPStan parity (Builder::with()
            expects the 2-parameter Closure shape). Suppressed for app/Models
            (relation declarations) and app/Repositories (eager-load Closure
            shapes consumed by Builder::with()); removable in a single edit once
            the plugin is upgraded past v3.14.
        -->
        <InvalidDocblock>
            <errorLevel type="suppress">
                <directory name="app/Models" />
                <directory name="app/Repositories" />
                <directory name="app/Domains/Catalog/Repositories" />
                <directory name="app/Domains/Users/Repositories" />
                <directory name="app/Domains/Cart/Services" />
                <directory name="app/Domains/Checkout/Services" />
            </errorLevel>
        </InvalidDocblock>
    </issueHandlers>
</psalm>
