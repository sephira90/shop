{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "type-check": "vue-tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint \"resources/js/**/*.{ts,vue}\"",
        "audit": "npm audit --omit=dev --audit-level=high",
        "lint:ox": "oxlint --vue-plugin --vitest-plugin resources/js",
        "lint:ox:fix": "oxlint --vue-plugin --vitest-plugin --fix resources/js",
        "format": "prettier --write \"resources/js/**/*.{ts,vue}\"",
        "format:ox": "oxfmt --write resources/js",
        "format:ox:check": "oxfmt --check resources/js"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^25.2.3",
        "@vitejs/plugin-vue": "^6.0.4",
        "@vitest/coverage-v8": "^4.1.9",
        "@vue/eslint-config-typescript": "^14.7.0",
        "@vue/test-utils": "^2.4.6",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "eslint": "^10.0.0",
        "eslint-plugin-vue": "^10.8.0",
        "jsdom": "^28.1.0",
        "laravel-vite-plugin": "^2.0.0",
        "oxfmt": "^0.34.0",
        "oxlint": "^1.72.0",
        "prettier": "^3.8.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.0",
        "vite": "^7.0.7",
        "vitest": "^4.0.18",
        "vue-eslint-parser": "^10.4.0",
        "vue-tsc": "^3.2.4"
    },
    "dependencies": {
        "pinia": "^3.0.4",
        "vue": "^3.5.28",
        "vue-router": "^5.0.2"
    }
}
